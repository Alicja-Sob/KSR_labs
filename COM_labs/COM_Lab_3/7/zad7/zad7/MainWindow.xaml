<Window x:Class="zad7.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:zad7"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="149*" />
            <RowDefinition Height="139*" />
            <RowDefinition Height="146*" />
        </Grid.RowDefinitions>

        <!-- wyswietlanie pliku pdf -->
        <WindowsFormsHost Grid.Row="0" Name="pdfHost" Margin="0,0,0,125" Grid.RowSpan="2"/>

        <!-- odtwarzanie pliku wav -->
        <MediaElement Grid.Row="1" Name="playerHost"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Stop"
                      MediaOpened="mediaPlayer_MediaOpened"
                      MediaEnded="mediaPlayer_MediaEnded"
                      Margin="0,17,0,0"/>

        <!-- otwieranie strony www -->
        <WindowsFormsHost Grid.Row="1" Name="webHost" Margin="0,125,0,0" Grid.RowSpan="2" />
    </Grid>
</Window>
