@model List<string>

@{
    ViewData["Title"] = "Rented books";
}

<div class="row">
    <div class="col-md-12">
        <h2>Returned list from the library service: </h2>
        <ul>
            @foreach (var book in Model)
            {
                <li>@book</li>
            }
        </ul>
    </div>
</div>